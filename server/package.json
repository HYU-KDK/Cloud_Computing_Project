{
    "name": "paperquest-backend",
    "version": "1.0.0",
    "description": "Backend API for PaperQuest",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "prisma:generate": "prisma generate",
        "prisma:push": "prisma db push"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "^3.500.0",
        "@prisma/client": "^5.10.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.1",
        "express": "^4.18.2",
        "morgan": "^1.10.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.11.16",
        "prisma": "^5.10.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    }
}